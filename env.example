# .env  —  Tektronix MCP Server secrets
# Place in C:\Users\u610842\TektronixMCP\
#
# IMPORTANT: Never commit this file to Git.
#            The .gitignore entry for .env is already standard practice.
#
# Copy this file: copy .env.example .env
# Then fill in your real values below.

# ── OpenAI (vector store semantic search) ─────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...

# ── OpenAI vector store ID (from your existing MCP server setup) ──────────────
OPENAI_VECTOR_STORE_ID=vs_...your-store-id-here...

# ── MCP server transport settings ─────────────────────────────────────────────
MCP_HOST=0.0.0.0        # Listen on all interfaces so Claude Desktop can reach it
MCP_PORT=8000

# ── Optional: default instrument address ──────────────────────────────────────
# Used by tek_instrument_autoconnect if no address is supplied at runtime
# DEFAULT_VISA_ADDRESS=TCPIP0::192.168.1.100::inst0::INSTR
